{
  "name": "agent-muster",
  "version": "0.1.19",
  "description": "A local web interface for managing coding agents, projects, sessions, and DingTalk/Feishu integrations.",
  "author": "sexyAmole",
  "license": "MIT",
  "homepage": "https://github.com/sexyAmole/agent-muster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sexyAmole/agent-muster.git"
  },
  "bugs": {
    "url": "https://github.com/sexyAmole/agent-muster/issues"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "codex",
    "claude-code",
    "dingtalk",
    "feishu"
  ],
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "bin": {
    "agent-muster": "./bin/agent-muster.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts web --dev --no-open",
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs && vite build --config web/vite.config.ts",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "start": "node bin/agent-muster.js web --no-open",
    "desktop": "pnpm build && electron .",
    "desktop:pack": "pnpm build && electron-builder --dir",
    "desktop:pack:win": "pnpm build && electron-builder --win --x64 --dir",
    "desktop:dist": "pnpm build && electron-builder",
    "desktop:dist:win": "pnpm build && electron-builder --win --x64",
    "desktop:dist:all": "pnpm build && electron-builder --mac && electron-builder --win --x64",
    "postinstall": "node scripts/prepare-terminal.mjs"
  },
  "files": [
    "bin",
    "dist",
    "web/dist",
    "resources/desktop",
    "README.zh-CN.md",
    "scripts/prepare-terminal.mjs"
  ],
  "devDependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dingtalk-stream": "2.1.6-beta.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "express": "^5.1.0",
    "material-icon-theme": "^5.39.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "shiki": "^4.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "undici": "^8.11.2",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/desktop/main.js",
  "build": {
    "appId": "com.agent-muster.desktop",
    "productName": "Agent Muster",
    "directories": {
      "output": "release",
      "buildResources": "resources/desktop"
    },
    "files": [
      "dist/desktop/**/*",
      "web/dist/**/*",
      "resources/desktop/loading.html",
      "resources/desktop/icon.svg",
      "package.json"
    ],
    "mac": {
      "identity": "-",
      "notarize": false,
      "artifactName": "Agent-Muster-${version}-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "resources/desktop/icon.icns"
    },
    "win": {
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}",
      "target": [
        "nsis"
      ],
      "icon": "resources/desktop/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "resources/desktop/icon.png"
    },
    "extraResources": [
      {
        "from": "resources/desktop/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  }
}
